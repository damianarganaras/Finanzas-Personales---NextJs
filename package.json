{
  "name": "firefly-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-complete": "tsx prisma/seed-complete.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:db": "vitest run src/test/database.test.ts src/test/database-constraints.test.ts",
    "test:setup": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-test-db.ps1",
    "test:setup-bash": "bash ./scripts/setup-test-db.sh",
  "db:test-reset": "DATABASE_URL=\"mysql://root:@localhost:3306/firefly_test\" npx prisma migrate reset --force",
  "db:normalize": "tsx scripts/normalize-data.ts"
  },
