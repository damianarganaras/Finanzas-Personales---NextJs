// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Users y autenticación
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?
  password    String
  verified    Boolean  @default(false)
  userGroupId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  userGroup            UserGroup             @relation(fields: [userGroupId], references: [id])
  accounts             Account[]
  transactionJournals  TransactionJournal[]
  budgets              Budget[]
  categories           Category[]
  tags                 Tag[]
  bills                Bill[]
  piggyBanks           PiggyBank[]
  savingGoals          SavingGoal[]
  rules                Rule[]
  attachments          Attachment[]
  creditCards          CreditCard[]
  
  @@map("users")
}

model UserGroup {
  id    String @id @default(cuid())
  title String
  users User[]
  
  @@map("user_groups")
}

// Tipos de cuenta
model AccountType {
  id       String    @id @default(cuid())
  type     String    @unique // asset, expense, revenue, liability
  name     String
  accounts Account[]
  
  @@map("account_types")
}

// Cuentas
model Account {
  id              String      @id @default(cuid())
  name            String
  accountTypeId   String
  virtualBalance  Decimal?    @db.Decimal(15, 2)
  iban            String?
  active          Boolean     @default(true)
  userId          String
  userGroupId     String
  currencyId      String      @default("1")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  accountType     AccountType @relation(fields: [accountTypeId], references: [id])
  user            User        @relation(fields: [userId], references: [id])
  currency        Currency    @relation(fields: [currencyId], references: [id])
  transactions    Transaction[]
  creditCards     CreditCard[]
  
  @@map("accounts")
}

// Monedas
model Currency {
  id     String @id @default(cuid())
  code   String @unique // USD, EUR, etc.
  name   String
  symbol String
  
  accounts Account[]
  
  @@map("currencies")
}

// Transacciones agrupadas
model TransactionJournal {
  id          String   @id @default(cuid())
  userId      String
  description String
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]
  
  @@map("transaction_journals")
}

// Transacciones individuales
model Transaction {
  id                    String   @id @default(cuid())
  accountId             String
  transactionJournalId  String
  amount                Decimal  @db.Decimal(15, 2)
  description           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  account              Account           @relation(fields: [accountId], references: [id])
  transactionJournal   TransactionJournal @relation(fields: [transactionJournalId], references: [id])
  categories           TransactionCategory[]
  tags                 TransactionTag[]
  creditCardPurchase   CreditCardPurchase?
  installmentPayment   InstallmentPayment?
  
  @@map("transactions")
}

// Categorías
model Category {
  id     String @id @default(cuid())
  name   String
  userId String
  
  user         User                   @relation(fields: [userId], references: [id])
  transactions TransactionCategory[]
  budgets      BudgetCategory[]
  bills        Bill[]
  
  @@map("categories")
}

// Relación many-to-many entre transacciones y categorías
model TransactionCategory {
  transactionId String
  categoryId    String
  
  transaction Transaction @relation(fields: [transactionId], references: [id])
  category    Category    @relation(fields: [categoryId], references: [id])
  
  @@id([transactionId, categoryId])
  @@map("transaction_categories")
}

// Etiquetas
model Tag {
  id     String @id @default(cuid())
  name   String
  userId String
  
  user         User           @relation(fields: [userId], references: [id])
  transactions TransactionTag[]
  
  @@map("tags")
}

// Relación many-to-many entre transacciones y etiquetas
model TransactionTag {
  transactionId String
  tagId         String
  
  transaction Transaction @relation(fields: [transactionId], references: [id])
  tag         Tag         @relation(fields: [tagId], references: [id])
  
  @@id([transactionId, tagId])
  @@map("transaction_tags")
}

// Presupuestos
model Budget {
  id     String @id @default(cuid())
  name   String
  active Boolean @default(true)
  userId String
  
  user       User             @relation(fields: [userId], references: [id])
  limits     BudgetLimit[]
  categories BudgetCategory[]
  
  @@map("budgets")
}

// Límites de presupuesto
model BudgetLimit {
  id        String   @id @default(cuid())
  budgetId  String
  amount    Decimal  @db.Decimal(15, 2)
  startDate DateTime
  endDate   DateTime
  
  budget    Budget @relation(fields: [budgetId], references: [id])
  
  @@map("budget_limits")
}

// Relación many-to-many entre presupuestos y categorías
model BudgetCategory {
  budgetId   String
  categoryId String
  
  budget   Budget   @relation(fields: [budgetId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])
  
  @@id([budgetId, categoryId])
  @@map("budget_categories")
}

// Facturas recurrentes
model Bill {
  id           String   @id @default(cuid())
  name         String
  description  String?
  amount       Decimal  @db.Decimal(15, 2)
  frequency    String   // monthly, weekly, yearly, etc.
  nextDueDate  DateTime
  active       Boolean  @default(true)
  autoPayEnabled Boolean @default(false)
  userId       String
  categoryId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])
  
  @@map("bills")
}

// Metas de ahorro (Piggy Banks)
model PiggyBank {
  id          String   @id @default(cuid())
  name        String
  targetAmount Decimal @db.Decimal(15, 2)
  currentAmount Decimal @db.Decimal(15, 2) @default(0)
  targetDate  DateTime?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id])
  
  @@map("piggy_banks")
}

// Reglas de automatización
model Rule {
  id     String @id @default(cuid())
  title  String
  active Boolean @default(true)
  userId String
  
  user      User         @relation(fields: [userId], references: [id])
  triggers  RuleTrigger[]
  actions   RuleAction[]
  
  @@map("rules")
}

// Triggers de reglas
model RuleTrigger {
  id    String @id @default(cuid())
  ruleId String
  type  String // description_contains, amount_greater_than, etc.
  value String
  
  rule Rule @relation(fields: [ruleId], references: [id])
  
  @@map("rule_triggers")
}

// Acciones de reglas
model RuleAction {
  id     String @id @default(cuid())
  ruleId String
  type   String // set_category, set_tag, etc.
  value  String
  
  rule Rule @relation(fields: [ruleId], references: [id])
  
  @@map("rule_actions")
}

// Archivos adjuntos
model Attachment {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  userId       String
  createdAt    DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id])
  
  @@map("attachments")
}

// Metas de ahorro (nueva implementación con moneda y aportes)
model SavingGoal {
  id            String   @id @default(cuid())
  userId        String
  name          String
  currency      String   // 'ARS' | 'USD'
  targetAmount  Decimal  @db.Decimal(15, 2)
  currentAmount Decimal  @db.Decimal(15, 2) @default(0)
  dueDate       DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user           User                   @relation(fields: [userId], references: [id])
  contributions  SavingContribution[]

  @@map("saving_goals")
}

model SavingContribution {
  id       String   @id @default(cuid())
  goalId   String
  amount   Decimal  @db.Decimal(15, 2)
  currency String   // 'ARS' | 'USD'
  date     DateTime
  createdAt DateTime @default(now())

  goal SavingGoal @relation(fields: [goalId], references: [id])

  @@map("saving_contributions")
}

// Tarjetas de crédito
model CreditCard {
  id           String   @id @default(cuid())
  name         String   // Nombre de la tarjeta (ej: "Visa Santander")
  last4Digits  String   // Últimos 4 dígitos
  limit        Decimal  @db.Decimal(15, 2) // Límite de crédito
  closingDay   Int      // Día de cierre (1-31)
  dueDay       Int      // Día de vencimiento (1-31)
  active       Boolean  @default(true)
  userId       String
  accountId    String   // Cuenta asociada (tipo liability)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  user         User       @relation(fields: [userId], references: [id])
  account      Account    @relation(fields: [accountId], references: [id])
  purchases    CreditCardPurchase[]
  
  @@map("credit_cards")
}

// Compras con tarjeta de crédito
model CreditCardPurchase {
  id             String   @id @default(cuid())
  creditCardId   String
  transactionId  String   @unique // Transacción original
  totalAmount    Decimal  @db.Decimal(15, 2) // Monto total de la compra
  installments   Int      // Número de cuotas
  hasInterest    Boolean  @default(false) // Si tiene interés
  interestRate   Decimal? @db.Decimal(5, 4) // Tasa de interés (ej: 0.0299 = 2.99%)
  description    String
  purchaseDate   DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  creditCard     CreditCard @relation(fields: [creditCardId], references: [id])
  transaction    Transaction @relation(fields: [transactionId], references: [id])
  installmentPayments InstallmentPayment[]
  
  @@map("credit_card_purchases")
}

// Cuotas individuales
model InstallmentPayment {
  id                    String   @id @default(cuid())
  creditCardPurchaseId  String
  installmentNumber     Int      // Número de cuota (1, 2, 3...)
  amount               Decimal  @db.Decimal(15, 2) // Monto de esta cuota
  dueDate              DateTime // Fecha de vencimiento
  paidDate             DateTime? // Fecha en que se pagó (null si no se pagó)
  transactionId        String?  @unique // Transacción de pago (si se pagó)
  status               String   @default("pending") // pending, paid, overdue
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  
  creditCardPurchase   CreditCardPurchase @relation(fields: [creditCardPurchaseId], references: [id])
  paymentTransaction   Transaction? @relation(fields: [transactionId], references: [id])
  
  @@unique([creditCardPurchaseId, installmentNumber])
  @@map("installment_payments")
}
